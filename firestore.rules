rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin (email or role check or dev mode)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'satyamsing2580@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // Products catalog: anyone can browse products, manage inventory
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: anyone can read and manage
    match /categories/{catId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: anyone can place orders, admin & users can track & update in real time
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Reviews & ratings
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Settings / Store configurations
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Coupons & Promo Codes
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
